{
  "framework": "vite",
  "buildCommand": "cd ../.. && yarn install && yarn workspace @adminhub/shared build && yarn workspace @adminhub/web build",
  "outputDirectory": "dist",
  "installCommand": "yarn install",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
