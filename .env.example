# ─── App ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────
# Default for a fresh PostgreSQL Windows install (user=postgres, your chosen password)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/adminhub_db

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Azure AD (MSAL) ──────────────────────────────────────────────
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_REDIRECT_URI=http://localhost:4000/api/auth/callback

# ─── File Storage ────────────────────────────────────────────────
# Leave blank in local dev — uploads are skipped gracefully.
# Fill these in for production (Azure Blob) or when you need upload testing.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=adminhub-uploads

# ─── Email (Nodemailer) ───────────────────────────────────────────
# In local dev emails are logged to console (no SMTP required).
# Set these only when you want real email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Utthunga AdminHub <noreply@utthunga.com>"

# ─── HRMS / ERP Webhook ───────────────────────────────────────────
HRMS_WEBHOOK_SECRET=change_me_hrms_hmac_secret
ERP_WEBHOOK_SECRET=change_me_erp_hmac_secret

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
